{
  "name": "prompt-assistant",
  "productName": "提示词助手",
  "version": "2.8.1",
  "description": "常驻托盘的提示词速查/复制助手，数据来自飞书多维表",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "gen-icon": "node tools/apply-logo-icon.js",
    "gen-tray-template": "node tools/gen-tray-template.js",
    "dist": "electron-builder --win nsis --mac",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.promptassistant.tray",
    "productName": "提示词助手",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!cache/**",
      "!dist/**",
      "!tools/**",
      "!app.log",
      "!start.bat",
      "!启动提示词助手.vbs",
      "!启动提示词助手.command",
      "!data-test-imgs/**"
    ],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "PromptAssistant-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "提示词助手 ${version}",
      "artifactName": "提示词助手-${version}-mac-${arch}.dmg"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "language": "2052",
      "shortcutName": "提示词助手",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  }
}
